{
  "uid": "lodestone-cost",
  "title": "Lodestone cost per player",
  "tags": [
    "lodestone"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "lodestone-prom"
        },
        "query": {
          "query": "label_values(lodestone_build_info, env)",
          "refId": "env"
        },
        "refresh": 2,
        "current": {},
        "includeAll": true,
        "multi": false
      },
      {
        "name": "monthly_cost_usd",
        "label": "Monthly cost (USD)",
        "type": "textbox",
        "query": "0",
        "current": {
          "text": "0",
          "value": "0"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Spec 13: *a small dashboard tracks monthly cost divided by peak concurrent players*. Set **monthly_cost_usd** (top) from the billing report for the month (Billing > Reports, filter the project; infra/cost/README.md has the line items). Peak CCU comes from `max_over_time(sum(zone_players)[30d])`. WP19 records the number in docs/decisions/v1-capacity.md."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Monthly cost (input)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lodestone-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lodestone-prom"
          },
          "expr": "vector($monthly_cost_usd)",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Peak CCU (30 d)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lodestone-prom"
      },
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lodestone-prom"
          },
          "expr": "max_over_time(sum(zone_players{env=~\"$env\"})[30d:1m])",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cost per peak player",
      "description": "monthly cost / max(1, peak CCU)",
      "datasource": {
        "type": "prometheus",
        "uid": "lodestone-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lodestone-prom"
          },
          "expr": "vector($monthly_cost_usd) / clamp_min(max_over_time(sum(zone_players{env=~\"$env\"})[30d:1m]), 1)",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "VM awake (30 d)",
      "description": "Hours the zone answered scrapes: the VM is billed only while awake (wake on demand).",
      "datasource": {
        "type": "prometheus",
        "uid": "lodestone-prom"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lodestone-prom"
          },
          "expr": "sum(count_over_time(up{job=\"zone\",env=~\"$env\"}[30d:5m])) * 5 / 60",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Concurrent players",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lodestone-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lodestone-prom"
          },
          "expr": "sum(zone_players{env=~\"$env\"})",
          "legendFormat": "players"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Zone egress per player",
      "description": "Bandwidth is the real cost (spec 13 rule 4).",
      "datasource": {
        "type": "prometheus",
        "uid": "lodestone-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "lodestone-prom"
          },
          "expr": "sum(rate(zone_bytes_out_total{env=~\"$env\"}[5m])) * 8 / clamp_min(sum(zone_players{env=~\"$env\"}), 1)",
          "legendFormat": "egress per player"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
