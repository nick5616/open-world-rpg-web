# Netlify headers for the game client (copied to client/dist/_headers by
# infra/deploy.mjs). Vite's /assets/* names carry content hashes (JS, CSS,
# and worldgen-<hash>.wasm), so they are cached forever: each player
# downloads them once (spec 13: bandwidth is the real cost). Unhashed
# textures revalidate hourly; index.html always.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/textures/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/basis/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/index.html
  Cache-Control: no-cache
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
