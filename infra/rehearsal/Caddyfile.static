# Stand-in for Netlify in the local rehearsal: serves the production client
# and creator builds with the same cache rules infra/netlify/ gives Netlify
# (_headers) and the creator's /v1 proxy (_redirects).
{
	admin off
	auto_https off
}

:8080 {
	root * /srv/client
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header /textures/* Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
	header /basis/* Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
	header /index.html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

:8081 {
	handle /v1/* {
		reverse_proxy {$CREATOR_UPSTREAM}
	}
	handle {
		root * /srv/creator
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
